{
  "_aciklama": "Metinden gorsel (SDXL tek dosya checkpoint). --ayar PROMPT=\"...\" zorunlu; istege bagli: NEGATIF, seed=rastgele, steps, cfg, width/height, ckpt_name, filename_prefix, batch_size",
  "4": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Model"},
        "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}},
  "5": {"class_type": "EmptyLatentImage", "_meta": {"title": "Boyut"},
        "inputs": {"width": 1344, "height": 768, "batch_size": 1}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "Pozitif"},
        "inputs": {"text": "$PROMPT", "clip": ["4", 1]}},
  "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negatif"},
        "inputs": {"text": "text, watermark, logo, signature, blurry, lowres, deformed, extra fingers", "clip": ["4", 1]}},
  "3": {"class_type": "KSampler", "_meta": {"title": "Ornekleyici"},
        "inputs": {"seed": 1, "steps": 30, "cfg": 7.0, "sampler_name": "dpmpp_2m", "scheduler": "karras",
                   "denoise": 1.0, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}},
  "8": {"class_type": "VAEDecode", "_meta": {"title": "VAE"},
        "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
  "9": {"class_type": "SaveImage", "_meta": {"title": "Kaydet"},
        "inputs": {"filename_prefix": "claude", "images": ["8", 0]}}
}
